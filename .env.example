# ===== LLM =====
# Провайдер: yandex (по умолчанию, RU) | openai (любой OpenAI-совместимый эндпоинт)
LLM_PROVIDER=yandex

# Yandex Cloud ML (получить в консоли Yandex Cloud: folder id + API key сервис-аккаунта)
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_COMPLETION_MODEL=yandexgpt-lite

# OpenAI-совместимый провайдер (используется при LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== Embeddings =====
# yandex (256-dim, RU) | openai. При смене провайдера индекс нужно пересобрать (scripts/reindex.py).
EMBEDDINGS_PROVIDER=yandex

# ===== Server =====
API_HOST=127.0.0.1
API_PORT=8765
# Публичный URL для ссылок на PDF (#page=N). Пусто = брать из входящего запроса.
PUBLIC_BASE_URL=
CORS_ORIGINS=*

# ===== Admin =====
ADMIN_PASSWORD=change-me

# ===== Telegram =====
TELEGRAM_TOKEN=
BACKEND_URL=http://127.0.0.1:8765

# ===== RAG =====
TOP_K=10
BEST_K=6
PAGE_WINDOW=1
MAX_SNIPPET=1200
CHUNK_CHARS=900
CHUNK_OVERLAP=200

# ===== Crawler =====
CRAWL_SEEDS=https://letovo.ru,https://qletovo.ru
CRAWL_DELAY=1.0
CRAWL_MAX_PAGES=400
