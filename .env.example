# ===== LLM / Embeddings: OpenAI (ChatGPT) =====
# Ключ OpenAI (https://platform.openai.com/api-keys), формат sk-...
OPENAI_API_KEY=
# Пусто => https://api.openai.com/v1. Заполни для OpenAI-совместимого прокси.
OPENAI_BASE_URL=
# Чат-модель (ответы):
OPENAI_MODEL=gpt-5-mini
# reasoning_effort для gpt-5* (minimal|low|medium|high); low — баланс скорость/качество.
REASONING_EFFORT=low
# Модель эмбеддингов (индексация/поиск). При смене — пересобери индекс (scripts/reindex).
OPENAI_EMBED_MODEL=text-embedding-3-small

# ===== Server =====
API_HOST=127.0.0.1
API_PORT=8765
# Публичный URL для ссылок на PDF. ПУСТО = брать домен из запроса (рекомендуется:
# работает на любом домене автоматически, в т.ч. за nginx). Задайте явно,
# только если нужен фиксированный канонический домен.
PUBLIC_BASE_URL=
CORS_ORIGINS=*

# ===== Admin =====
ADMIN_PASSWORD=change-me

# ===== RAG =====
TOP_K=20
BEST_K=10
PAGE_WINDOW=0
MAX_SNIPPET=1200
CHUNK_CHARS=900
CHUNK_OVERLAP=200
# Потолок числа блоков контекста LLM (чтобы промпт не раздувался → быстрый ответ).
CONTEXT_MAX_BLOCKS=10
# MMR-диверсификация выдачи: меньше near-дублей, в контекст попадают разные релевантные
# документы (факт, размазанный по нескольким документам, собирается целиком). pool — размер
# кандидатов, lambda — баланс релевантность/разнообразие (0..1, выше = релевантнее).
MMR_ENABLED=1
MMR_POOL=50
MMR_LAMBDA=0.6
# Query-expansion (RAG-fusion): LLM генерирует переформулировки, результаты сливаются по RRF —
# поиск меньше зависит от формулировки вопроса. Стоит +1 LLM-вызов (~+3-5с к ответу).
# Выключить для скорости: QUERY_EXPANSION=0.
QUERY_EXPANSION=1
QUERY_EXPANSION_N=3
# Порог «вне зоны школы». Для text-embedding-3-small 0 (отключён): off-topic и тематические
# вопросы по косинусу не разделяются — отказ делает LLM по промпту.
OFFTOPIC_GATE=0
# Документы, которые НЕ индексировать (regex по имени файла). По умолчанию исключаем
# учебные программы/ООП/рабочие программы — они засоряют поиск по нормативным вопросам.
INDEX_EXCLUDE=(?i)(?:^(?:OOP|RP|DOOP)|рабоч|programm|annotac|uchebny)

# ===== OCR (для сканов без текстового слоя) =====
# Нужен системный tesseract + языки: macOS `brew install tesseract` + rus.traineddata;
# Debian/Docker `apt-get install tesseract-ocr tesseract-ocr-rus`. 0 = выключить OCR.
OCR_ENABLED=1
OCR_MIN_PAGE_CHARS=80
OCR_LANG=rus+eng
OCR_DPI=200

# ===== Crawler =====
CRAWL_SEEDS=https://letovo.ru,https://qletovo.ru
CRAWL_DELAY=1.0
CRAWL_MAX_PAGES=400
