[Unit]
Description=Letovo assistant Telegram bot
After=network-online.target qletovo-api.service
Wants=network-online.target
Requires=qletovo-api.service

[Service]
Type=simple
User=qletovo
WorkingDirectory=/opt/qletovo
EnvironmentFile=/opt/qletovo/.env
# BACKEND_URL берётся из .env (по умолчанию http://127.0.0.1:8765 — тот же хост).
ExecStart=/opt/qletovo/.venv/bin/python -m telegram.bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
